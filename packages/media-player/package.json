{
  "name": "@novel-editor/media-player",
  "version": "0.1.0",
  "private": true,
  "description": "Self-drawn React video / audio player: pluggable engines (native / hls.js / dash.js / mpegts.js), compatibility matrix, quality switching, speed, captions, PiP, screenshot & recording",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "keywords": [
    "react",
    "video",
    "player",
    "media",
    "hls",
    "dash",
    "flv",
    "audio"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TaitaiWx/novel-editor-se.git",
    "directory": "packages/media-player"
  },
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  },
  "peerDependencies": {
    "dashjs": "^4.7.0 || ^5.0.0",
    "hls.js": "^1.5.0",
    "mpegts.js": "^1.7.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "peerDependenciesMeta": {
    "dashjs": {
      "optional": true
    },
    "hls.js": {
      "optional": true
    },
    "mpegts.js": {
      "optional": true
    }
  },
  "devDependencies": {
    "dashjs": "^5.2.1",
    "hls.js": "^1.7.3",
    "mpegts.js": "^1.8.2",
    "rimraf": "^6.0.1"
  }
}
