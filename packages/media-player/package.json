{
  "name": "@novel-editor/media-player",
  "version": "0.1.0",
  "private": true,
  "description": "Self-drawn React video player (no third-party player): fit-to-ratio frame, floating controls, keyboard & screen-reader friendly, audio-track aware",
  "license": "UNLICENSED",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "!src/**/*.test.*",
    "README.md"
  ],
  "sideEffects": [
    "*.css",
    "*.scss"
  ],
  "keywords": [
    "react",
    "video",
    "player",
    "media"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/TaitaiWx/novel-editor-se.git",
    "directory": "packages/media-player"
  },
  "scripts": {
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "react-icons": "^5.5.0"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "rimraf": "^6.0.1"
  }
}
