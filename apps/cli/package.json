{
  "name": "@novel-editor/cli",
  "version": "1.1.0-beta.43",
  "private": true,
  "description": "Novel Editor - CLI tool",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "bin": {
    "novel-editor": "./dist/index.mjs",
    "ne": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.10.0"
  },
  "scripts": {
    "build": "vite build",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.mjs",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@novel-editor/ai": "workspace:*",
    "@novel-editor/core": "workspace:*",
    "@novel-editor/helpers": "workspace:*",
    "@novel-editor/video": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.0.10",
    "rimraf": "^6.0.1",
    "tsx": "^4.21.0",
    "vite": "^6.2.0"
  }
}
