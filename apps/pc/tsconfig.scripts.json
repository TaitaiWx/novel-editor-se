{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "allowJs": true,
    "checkJs": true,
    "types": ["node"],
    "allowImportingTsExtensions": true
  },
  "include": [
    "scripts/**/*.mts",
    "scripts/**/*.mjs",
    "scripts/**/*.cjs",
    "scripts/**/*.js",
    "scripts/**/*.d.ts",
    "../../scripts/**/*.mjs",
    "../../scripts/**/*.cjs",
    "../../scripts/**/*.js",
    "signing/**/*.mjs"
  ]
}
